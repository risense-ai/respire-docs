{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Respire Core response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string"},
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"enum": [1, 2, 3, 6, 7]},
        "message": {"type": "string"}
      }
    }
  },
  "$defs": {
    "relatedResult": {
      "type": "object", "additionalProperties": false, "required": ["related", "superseded"],
      "properties": {
        "superseded": {"type": "object", "additionalProperties": {"type": "string"}},
        "related": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "title", "source_id", "relation"],
          "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "source_id": {"type": "string"},
            "relation": {"enum": ["new_version", "old_version", "see_also", "co_recall", "neighbor"]}}
        }}
      }
    }
  },
  "oneOf": [
    {"required": ["result"], "not": {"required": ["error"]}},
    {"required": ["error"], "not": {"required": ["result"]}}
  ]
}

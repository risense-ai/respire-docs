{
  "schemaVersion": 1,
  "distribution": "binary-sdk-staticlib-c-abi",
  "publish": false,
  "abiVersion": 65538,
  "requestSchemaVersion": 1,
  "artifactVersion": 1,
  "consumerRepos": [
    "risense-ai/respire-cli",
    "risense-ai/respire-server"
  ],
  "operations": [
    "capabilities",
    "prepare",
    "query",
    "remember_candidates",
    "candidate_report",
    "analyze_duplicates",
    "tree_cure",
    "deepen_plan",
    "tree_float",
    "taxonomy_classify",
    "classify_business",
    "query_business",
    "memory_metadata_validate",
    "memory_evidence_evaluate",
    "related_business",
    "index_generation",
    "index_status",
    "resident_publish",
    "resident_release",
    "index_reusable",
    "model_status",
    "model_probe",
    "engine_control"
  ],
  "notes": [
    "Infrastructure consumers never check out Core source.",
    "Server pins the infrastructure app package by Git commit, without depending on the CLI executable.",
    "Account keys, auth, sync, HTTP and SQLite stay in infrastructure source.",
    "Feature artifacts are opaque local derived data, not encrypted secrets; they can be rebuilt.",
    "Legacy sync ciphertext and SQLite compatibility are retained.",
    "ONNX inference executes in process from host-owned input buffers. Core has no filesystem, database, path discovery or environment access; the host persists opaque index bytes."
  ],
  "repository": "risense-ai/respire-core",
  "sourceRepository": "risense-ai/respire-cli",
  "applicationCrates": [
    {
      "name": "respire_protocol",
      "path": "crates/protocol"
    },
    {
      "name": "respire_crypto",
      "path": "crates/crypto"
    },
    {
      "name": "respire_storage",
      "path": "crates/storage"
    },
    {
      "name": "respire_core_sdk",
      "path": "crates/core-sdk"
    },
    {
      "name": "respire_app",
      "path": "crates/app"
    }
  ],
  "engineCrates": [
    "respire_core",
    "respire_core_ffi",
    "respire_winml"
  ],
  "optionalExtensions": {
    "model_input_stream_contract": {
      "version": 1,
      "requires": "cpu-owned-ort-experiment",
      "experimental": true,
      "abiVersionUnchanged": 65538,
      "maxModelBytes": 1073741824,
      "maxChunkBytes": 4194304,
      "stagingBudgetBytes": 1073741824,
      "functions": [
        "rs_core_model_input_begin",
        "rs_core_model_input_append",
        "rs_core_model_input_commit",
        "rs_core_model_input_abort"
      ]
    }
  }
}
